generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Task 1.1 — core entities MVP-версии Data Model (18_DATA_MODEL.md §45,
// зеркалирует TASKS.md): User, Goal, Content, ContentFeature,
// PerformanceMetric, Pattern, Memory, Recommendation, UserDecision,
// Experiment. Поля — по 25_DATABASE_SCHEMA.md. Остальные сущности из
// более широкого MVP_DATABASE (§62 того же документа — ExternalAccount,
// Baseline, RecommendationReason/Candidate, Action, Outcome, Hypothesis,
// Event и т.д.) сознательно не реализованы в этой задаче — добавляются
// постепенно в следующих задачах Phase 1, без разрушающих миграций для
// уже созданных таблиц.
//
// Поля open-ended категоризации (goalType, contentType, patternType,
// featureType, metricType, memoryType-подобные штуки, где docs явно
// требуют расширяемости без миграции — см. 25_DATABASE_SCHEMA.md §57)
// — String, не enum. Enum используется только для реально закрытых,
// зафиксированных в доках наборов состояний (статусы, decision type).
//
// NULL vs 0: там, где документ явно требует различать "значение 0" и
// "данные недоступны" (§56), числовое поле — nullable.

enum PatternDirection {
  positive
  negative
}

enum PatternStatus {
  hypothesis
  emerging
  confirmed
  strong
  declining
  inactive
}

enum MemoryType {
  fact
  pattern
  preference
  decision
  lesson
  hypothesis
}

enum RecommendationStatus {
  generated
  shown
  accepted
  rejected
  modified
  postponed
  completed
  expired
}

enum UserDecisionType {
  accepted
  rejected
  modified
  deferred
  alternative_selected
}

// Task 3.3 — закрытый набор состояний подключения внешней платформы
// (30_SECURITY_PRIVACY.md §25: disconnect обязан переводить в отдельный
// статус, не удалять запись молча).
enum ExternalAccountStatus {
  connected
  expired
  disconnected
}

// Task 9.1 — закрытый набор исходов AI-запроса, определён самим контрактом
// AIProvider (src/ai/AIProvider.ts, AIRunStatus) — не платформенная открытая
// категория вроде goalType/contentType, поэтому enum, не String.
enum AiRunStatus {
  completed
  failed
  timeout
  provider_unavailable
  validation_failed
}

model User {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastActiveAt DateTime? @map("last_active_at")
  status       String    @default("active")
  timezone     String?
  locale       String?

  // Task 2.1 — Auth.js (App Authentication, CLAUDE.md §3.2/§4.1). email/
  // emailVerified/name/image — стандартные поля, ожидаемые Auth.js Prisma
  // adapter'ом (имена полей заданы контрактом адаптера, не менять).
  // passwordHash — наше собственное поле для Credentials provider
  // (email+password), не часть стандартного контракта адаптера.
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")

  goals            Goal[]
  content          Content[]
  patterns         Pattern[]
  memories         Memory[]
  recommendations  Recommendation[]
  decisions        UserDecision[]
  accounts         Account[]
  sessions         Session[]
  externalAccounts ExternalAccount[]

  @@map("users")
}

// Account/Session/VerificationToken — стандартная схема Auth.js Prisma
// adapter (https://authjs.dev/getting-started/adapters/prisma), проверена
// по актуальной документации перед реализацией (Task 2.1, DECISIONS.md
// D-0009). Имена полей на Account (refresh_token, access_token, expires_at,
// token_type, id_token, session_state) заданы контрактом адаптера буквально
// как snake_case Prisma-поля, а не только DB-колонки — сознательное
// отступление от camelCase-конвенции остальной схемы, не опечатка.

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Goal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  goalType  String   @map("goal_type")
  priority  Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  experiments     Experiment[]

  @@index([userId])
  @@map("goals")
}

// Task 3.3 — data layer для хранения подключения внешних платформ
// (25_DATABASE_SCHEMA.md §7 EXTERNAL_ACCOUNTS). Поля userId/platform/
// externalUserId/status/connectedAt/lastSyncedAt — буквально из §7.
// accessToken/tokenExpiresAt — сверх §7, но практически необходимы для
// самой интеграции (нет отдельной сущности под токен в доках).
//
// SECURITY GAP (сознательный, зафиксирован в DECISIONS.md) — accessToken
// хранится обычным текстовым полем, БЕЗ encryption at rest.
// 30_SECURITY_PRIVACY.md §23 требует шифрование токенов внешних платформ;
// secret manager/шифрование отложены вместе с остальной cloud-
// инфраструктурой (D-0007). Обязательно закрыть до production.
//
// platform — String, не enum: открытая, расширяемая категория
// (25_DATABASE_SCHEMA.md §70 FUTURE_MULTI_PLATFORM — схема не должна
// предполагать одну платформу на пользователя навсегда; TikTok и другие
// платформы упоминаются как будущее в 08_METRICS_FRAMEWORK.md §16).
// Уникальность — по (platform, externalUserId), не по userId
// (25_DATABASE_SCHEMA.md §53) — один пользователь может подключить
// несколько аккаунтов, в том числе на разных платформах.
model ExternalAccount {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  platform       String
  externalUserId String                @map("external_user_id")
  status         ExternalAccountStatus @default(connected)
  connectedAt    DateTime              @default(now()) @map("connected_at")
  lastSyncedAt   DateTime?             @map("last_synced_at")
  accessToken    String                @map("access_token")
  tokenExpiresAt DateTime              @map("token_expires_at")
  // Task 3.4 — не в исходном списке полей §7/Task 3.3, добавлено по
  // прямому запросу Olga: у неё несколько связанных Instagram-аккаунтов,
  // и статус без имени не даёт убедиться, что подключён именно нужный.
  // Nullable — платформа может не вернуть username (или это будущая
  // платформа без такого понятия), различие "не пришло" vs "пустая
  // строка" важно (08_METRICS_FRAMEWORK.md §11 data completeness
  // принцип, применён здесь по аналогии).
  username       String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountSnapshots AccountSnapshot[]

  @@unique([platform, externalUserId])
  @@index([userId])
  @@map("external_accounts")
}

model Content {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  // Плейсхолдер-поля — ExternalAccount (выше) теперь существует как
  // реальная сущность (Task 3.3), но здесь всё ещё простые строковые
  // значения, не @relation: wiring в реальный внешний ключ — отдельная
  // задача Content-sync (Phase 4+), не эта.
  externalAccountId String?   @map("external_account_id")
  externalContentId String?   @map("external_content_id")
  contentType       String    @map("content_type")
  status            String    @default("published")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  features           ContentFeature[]
  performanceMetrics PerformanceMetric[]

  @@unique([externalAccountId, externalContentId])
  @@index([userId])
  @@index([publishedAt])
  @@map("content")
}

model ContentFeature {
  id              String   @id @default(cuid())
  contentId       String   @map("content_id")
  featureType     String   @map("feature_type")
  featureValue    String   @map("feature_value")
  confidence      Float?
  source          String?
  analysisVersion String?  @map("analysis_version")
  createdAt       DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("content_features")
}

model PerformanceMetric {
  id         String   @id @default(cuid())
  contentId  String   @map("content_id")
  metricType String   @map("metric_type")
  // Nullable, не 0 — "данные недоступны" ≠ "измеренное значение 0"
  // (25_DATABASE_SCHEMA.md §56).
  value      Int?
  measuredAt DateTime @map("measured_at")
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([measuredAt])
  @@map("performance_metrics")
}

// Task 4.2 — DECISIONS.md D-0014: account-level метрики (getAccountInsights,
// 08_METRICS_FRAMEWORK.md §2) не покрываются ни PerformanceMetric (жёстко
// привязан к content_id), ни Baseline/25_DATABASE_SCHEMA.md §16
// (вычисленное значение с confidence/sample_size, не сырое измерение) —
// реальный пробел в документированной схеме, не только в реализации.
// AccountSnapshot — по аналогии с PerformanceMetric, но на уровне
// ExternalAccount вместо Content.
model AccountSnapshot {
  id                String   @id @default(cuid())
  externalAccountId String   @map("external_account_id")
  metricType        String   @map("metric_type")
  // Nullable, не 0 — тот же принцип, что PerformanceMetric.value
  // (25_DATABASE_SCHEMA.md §56 NULL VS ZERO).
  value             Int?
  capturedAt        DateTime @map("captured_at")
  source            String?
  createdAt         DateTime @default(now()) @map("created_at")

  externalAccount ExternalAccount @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)

  @@index([externalAccountId])
  @@index([capturedAt])
  @@map("account_snapshots")
}

model Pattern {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  patternType     String           @map("pattern_type")
  description     String
  direction       PatternDirection
  strength        Float?
  confidence      Float?
  status          PatternStatus    @default(hypothesis)
  firstDetectedAt DateTime         @default(now()) @map("first_detected_at")
  lastConfirmedAt DateTime?        @map("last_confirmed_at")
  lastUpdatedAt   DateTime         @updatedAt @map("last_updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("patterns")
}

model Memory {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  memoryType MemoryType @map("memory_type")
  content    String
  confidence Float?
  source     String?
  status     String     @default("active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("memory")
}

// Task 9.3 — внешняя (не производная от пользовательских данных) база
// приёмов создания контента — заголовки/хуки/монтаж/стратегия платформ и
// т.д., загруженная из справочных материалов (Полное руководство.pdf +
// доп. файл). Сознательно НЕ привязана к userId — в отличие от Memory/
// Pattern (накопленное знание О пользователе), это внешнее ремесленное
// знание, одинаково применимое к любому пользователю приложения. AI при
// генерации текста читает эти записи из базы, не из захардкоженного
// текста в промпте/коде — прямое требование Olga, YELLOW-решение,
// см. DECISIONS.md D-0030.
model ContentKnowledge {
  id            String   @id @default(cuid())
  // Открытая категория (String, не enum) — тот же принцип, что
  // goalType/contentType/patternType/reasonType: список категорий будет
  // расти по мере пополнения базы, не зафиксирован заранее.
  category      String
  title         String
  content       String
  source        String
  sourceSection String?  @map("source_section")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("content_knowledge")
}

model Recommendation {
  id               String               @id @default(cuid())
  userId           String               @map("user_id")
  goalId           String               @map("goal_id")
  primaryCandidate String               @map("primary_candidate")
  confidence       Float?
  status           RecommendationStatus @default(generated)
  decisionVersion  String?              @map("decision_version")
  // Task 8.3 — снимок контекста решения (25_DATABASE_SCHEMA.md §30
  // RECOMMENDATION_CONTEXT: goal/relevant baseline/active patterns/
  // confidence/recent performance/skeleton version/decision version).
  // §30 не даёт фиксированный список колонок (в отличие от §28) и прямо
  // описывается как "снимок" — единственная запись на recommendation,
  // не список строк, поэтому JSON-колонка, а не отдельная таблица.
  context          Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  expiresAt        DateTime?            @map("expires_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal                   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  decisions UserDecision[]
  reasons   RecommendationReason[]
  aiRuns    AiRun[]

  @@index([userId])
  @@index([goalId])
  @@map("recommendations")
}

// Task 8.3 — 25_DATABASE_SCHEMA.md §28 RECOMMENDATION_REASONS. reasonType —
// String, не enum (тот же принцип, что goalType/patternType/metricType —
// открытый список категорий, см. комментарий в начале файла); документ
// перечисляет ориентировочный словарь значений (pattern/performance/
// baseline/goal/experiment/freshness/opportunity), не закрытый enum.
// weight — Float?, сознательно не заполняется этой задачей: числового
// веса причины нет ни у одного из уже посчитанных факторов (Task 8.1
// D-0024/Task 8.2 D-0025 — придуманный вес запрещён §40 NO FALSE
// PRECISION), не изобретается здесь только потому, что колонка есть.
model RecommendationReason {
  id               String   @id @default(cuid())
  recommendationId String   @map("recommendation_id")
  reasonType       String   @map("reason_type")
  description      String
  weight           Float?
  confidence       Float?

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("recommendation_reasons")
}

// Task 9.1 — 29_AI_LAYER.md §24 AI RUN/§76 КРИТИЧЕСКОЕ ПРАВИЛО №4
// (воспроизводимость: модель/версия/prompt/context/evidence/когда).
// Append-only лог каждого AI-запроса — AI не пишет в Recommendation
// напрямую (§67/§68), только в собственную лог-таблицу. `output` — Json?,
// провалидированное структурированное объяснение (§50 DECISION EXPLANATION,
// 21_DECISION_LOGIC.md) при успехе, либо `{ raw: text }` при
// validation_failed (для отладки, не выдаётся как настоящее объяснение),
// либо null при provider-level сбое. `status` — AiRunStatus, закрытый
// набор, определённый контрактом AIProvider, не документом.
model AiRun {
  id               String      @id @default(cuid())
  recommendationId String      @map("recommendation_id")
  provider         String
  model            String
  promptVersion    String      @map("prompt_version")
  status           AiRunStatus
  output           Json?
  inputTokens      Int?        @map("input_tokens")
  outputTokens     Int?        @map("output_tokens")
  latencyMs        Int?        @map("latency_ms")
  createdAt        DateTime    @default(now()) @map("created_at")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("ai_runs")
}

model UserDecision {
  id                String           @id @default(cuid())
  recommendationId  String           @map("recommendation_id")
  userId            String           @map("user_id")
  decisionType      UserDecisionType @map("decision_type")
  selectedCandidate String?          @map("selected_candidate")
  comment           String?
  createdAt         DateTime         @default(now()) @map("created_at")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@index([userId])
  @@map("user_decisions")
}

model Experiment {
  id           String    @id @default(cuid())
  // Плейсхолдер до появления сущности Hypothesis (вне scope Task 1.1) —
  // не relation.
  hypothesisId String?   @map("hypothesis_id")
  goalId       String    @map("goal_id")
  description  String
  status       String    @default("planned")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  result       String?
  conclusion   String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("experiments")
}
